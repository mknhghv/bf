local function startFlyHeartbeat()
    LPH_ATTRIBUTES(VM(NONE))
    if flyHeartbeatConn then return end
    flyHeartbeatConn = RunService.Heartbeat:Connect(function()
        if not currentFlyCFrame then return end
        local char = player and player.Character
        local curHrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not curHrp or not hum or hum.Health <= 0 then return end
        local curPos = curHrp.Position
        if curHrp.AssemblyAngularVelocity.Magnitude > 0.05 then
            curHrp.AssemblyAngularVelocity = Vector3.zero
        end
        local physicsState = Enum.HumanoidStateType.Physics
        if hum:GetState() ~= physicsState then
            hum:ChangeState(physicsState)
        end
        local now = os.clock()
        if now - lastPlatformCheckTime >= 0.1 then
            lastPlatformCheckTime = now
            if hum.PlatformStand then hum.PlatformStand = false end
            local head = char:FindFirstChild("Head") or curHrp
            if head and not head:FindFirstChild("NightVelocity") then
                ensureNightVelocity()
            end
        end
        local targetPos = currentFlyCFrame.Position
        local dist = (curPos - targetPos).Magnitude
        if dist <= 14 then
            if currentTween then currentTween:Cancel(); currentTween = nil end
            return
        end
        if currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing then
            if (currentTween.Instance.CFrame.Position - targetPos).Magnitude < 6 then
                return
            end
        end
        local tweenTime = math.max(dist / tweenSpeed(), 0.05)
        if currentTween then currentTween:Cancel() end
        local info = TweenInfo.new(tweenTime, FLY_EASING_STYLE, FLY_EASING_DIRECTION)
        currentTween = TweenService:Create(curHrp, info, {CFrame = currentFlyCFrame})
        currentTween:Play()
    end)
end
