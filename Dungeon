local WIN_ANIM_IN  = 0.70
local WIN_ANIM_OUT = 0.30
local WIN_ANIM_POP = 0.22
local WIN_ANIM_BTN = 0.26
local WIN_ANIM_MIN = 0.06
local MainHomePos = Main.Position
local winAnimConns = {}
local function stopAllWinAnim()
    for i = #winAnimConns, 1, -1 do
        local c = winAnimConns[i]
        winAnimConns[i] = nil
        pcall(function() c:Disconnect() end)
    end
end
local function runAnim(dur, easeOut, onStep, onDone)
    local t0 = os.clock()
    local finished = false
    local conn = nil
    local function detach()
        if conn then
            for i = #winAnimConns, 1, -1 do
                if winAnimConns[i] == conn then table.remove(winAnimConns, i) end
            end
            pcall(function() conn:Disconnect() end)
            conn = nil
        end
    end
    local function finishNow()
        if finished then return end
        finished = true
        detach()
        pcall(onStep, 1)
        if onDone then pcall(onDone) end
    end
    local function step()
        if finished then return end
        local a = (dur > 0) and math.clamp((os.clock() - t0) / dur, 0, 1) or 1
        local e = easeOut and (1 - (1 - a) ^ 4) or (a * a)
        if not pcall(onStep, e) then finishNow() return end
        if a >= 1 then finishNow() end
    end
    pcall(function() conn = RunService.RenderStepped:Connect(step) end)
    if not conn then pcall(function() conn = RunService.Heartbeat:Connect(step) end) end
    if not conn then
        finished = true
        pcall(onStep, 1)
        if onDone then pcall(onDone) end
        return
    end
    table.insert(winAnimConns, conn)
    step()
end
local function applyWinScale(s)
    local ap = Main.AnchorPoint
    local dW = Main.Size.X.Offset * (baseScale - s)
    local dH = Main.Size.Y.Offset * (baseScale - s)
    uiScale.Scale = s
    Main.Position = UDim2.new(
        MainHomePos.X.Scale, MainHomePos.X.Offset + (0.5 - ap.X) * dW,
        MainHomePos.Y.Scale, MainHomePos.Y.Offset + (0.5 - ap.Y) * dH
    )
end
local function showWindowAnimated()
    if Main.Visible or isAnimating then return end
    isAnimating = true
    stopAllWinAnim()
    local fromS = baseScale * WIN_ANIM_MIN
    Main.Visible = true
    applyWinScale(fromS)
    openBtn.Visible = true
    openScale.Scale = openBaseScale
    runAnim(WIN_ANIM_BTN, false, function(e)
        openScale.Scale = openBaseScale * (1 - e)
    end, function()
        openBtn.Visible = false
        openScale.Scale = openBaseScale
    end)
    runAnim(WIN_ANIM_IN, true, function(e)
        applyWinScale(fromS + (baseScale - fromS) * e)
    end, function()
        applyWinScale(baseScale)
        isAnimating = false
    end)
end
local function hideWindowAnimated()
    if not Main.Visible or isAnimating then return end
    isAnimating = true
    stopAllWinAnim()
    local fromS = baseScale
    local toS   = baseScale * WIN_ANIM_MIN
    openBtn.Visible = false
    openScale.Scale = openBaseScale
    runAnim(WIN_ANIM_OUT, false, function(e)
        applyWinScale(fromS + (toS - fromS) * e)
    end, function()
        Main.Visible = false
        applyWinScale(baseScale)
        openBtn.Visible = true
        openScale.Scale = 0
        runAnim(WIN_ANIM_POP, true, function(e)
            openScale.Scale = openBaseScale * e
        end, function()
            openScale.Scale = openBaseScale
            isAnimating = false
        end)
    end)
end
local function enableAnimatedDrag(handle, target, onClick, onMoved)
    local dragging = false
    local moved = false
    local dragStart, startPos
    local dragTween = nil
    local function endDrag()
        if dragging then
            dragging = false
            if dragTween then
                dragTween:Cancel()
                dragTween = nil
            end
            if moved and onMoved then onMoved() end
        end
    end
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = target.Position
        end
    end)
    table.insert(uiConnections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and not moved and onClick then
                onClick()
            end
            endDrag()
        end
    end))
    table.insert(uiConnections, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
