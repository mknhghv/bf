local function flyTo(targetCFrame, customSpeed, snapByTime)
    LPH_ATTRIBUTES(VM(NONE))
    if not hrp then return end
    local blocked = false
    pcall(function()
        blocked = game:GetService("CollectionService"):HasTag(player, "Teleporting")
            or (humanoid and humanoid.PlatformStand == true)
    end)
    if blocked then
        if currentTween then pcall(function() currentTween:Cancel() end); currentTween = nil end
        return
    end
    local pathJit = tonumber(CONFIG.FlyPathJitter) or 0
    if pathJit > 0 then
        local jx = (math.random() * 2 - 1) * pathJit
        local jy = (math.random() * 2 - 1) * pathJit
        local jz = (math.random() * 2 - 1) * pathJit
        targetCFrame = targetCFrame + Vector3.new(jx, jy, jz)
    end
    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    if distance ~= distance then return end

    local skip = currentTween ~= nil
        and currentTween.PlaybackState == Enum.PlaybackState.Playing
        and currentTween.Instance == hrp
        and lastFlyTarget ~= nil
        and (lastFlyTarget - targetCFrame.Position).Magnitude < 5
        and distance > 14
        and lastFlyDist ~= nil
        and distance < lastFlyDist - 0.3
    lastFlyDist = distance
    if skip then return end
    local speed = customSpeed or tweenSpeed()
    local time = distance / speed
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    lastFlyTarget = targetCFrame.Position
    local minTime = CONFIG.FlyMinTweenTime or 0.12
    local info = TweenInfo.new(math.max(time, minTime), FLY_EASING_STYLE, FLY_EASING_DIRECTION)
    pcall(function()
        currentTween = TweenService:Create(hrp, info, {CFrame = targetCFrame})
        currentTween:Play()
    end)
end
