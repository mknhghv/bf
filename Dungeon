                                bPos.Z + away.Unit.Z * safeDist
                            )
                        else

                            targetPos = hrp and hrp.Position or bPos
                        end
                    elseif pyroActive then

                        local prPos = target.CFrame.Position
                        local away  = hrp and (hrp.Position - prPos) or Vector3.new(1, 0, 0)
                        away = Vector3.new(away.X, 0, away.Z)
                        if away.Magnitude < 1 then away = Vector3.new(1, 0, 0) end
                        local side = away.Unit * (CONFIG.PyroWaitDist or 160)
                        targetPos = Vector3.new(
                            prPos.X + side.X,
                            prPos.Y + getAboveMonsterOffset(),
                            prPos.Z + side.Z
                        )
                    elseif bossMode then
                        local bossModel = target.Parent
                        local bossHead = bossModel and (bossModel:FindFirstChild("Head") or target)
                        local bossBase = bossHead and bossHead.Position or target.CFrame.Position
                        targetPos = bossBase
                            + Vector3.new(0, (CONFIG.BossHoverHeight or 5) + State.flyYBob(), 0)
                        if Config.OneShotEnabled and Config.OneShotMode == "instant" and bossModel
                            and State.LockedLevel ~= 15 then
                            local nowK = tick()
                            if nowK - (State.BossKillAt or 0) >= 0.2 then
                                State.BossKillAt = nowK
                                local bossHum = bossModel:FindFirstChildOfClass("Humanoid")
                                local meHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                                if meHrp then
                                    pcall(function()
                                        meHrp.CFrame = CFrame.new(targetPos)
                                    end)
                                end
                                if bossHum and bossHum.Health > 0 then
                                    pcall(function()
                                        bossHum.Health = 0
                                    end)
                                    State.BossKillInfo = "hp=" .. tostring(math.floor(bossHum.Health))
                                        .. "/" .. tostring(math.floor(bossHum.MaxHealth))
                                end
                            end
                        end
                    else
                        local rawFocus = bringFocusPoint(target)
                        if orbitCenter then
                            if (rawFocus - orbitCenter).Magnitude > 30 then
                                orbitCenter = rawFocus
                                orbitArrived = false
                            else
                                orbitCenter = orbitCenter:Lerp(rawFocus, 0.35)
                            end
                        else
                            orbitCenter = rawFocus
                            orbitArrived = false
                        end

                        local off = orbitOffset()
                        targetPos = Vector3.new(
                            orbitCenter.X + off.X,
                            rawFocus.Y + off.Y,
                            orbitCenter.Z + off.Z
                        )
                        if hrp and orbitCenter then
                            local dx = hrp.Position.X - orbitCenter.X
                            local dz = hrp.Position.Z - orbitCenter.Z
                            orbitArrived = (dx*dx + dz*dz) <= (ORBIT_RADIUS + 3) * (ORBIT_RADIUS + 3)
                        end
                    end
                    if onBossFloor and Config.OneShotEnabled and not targetIsProp
                        and BOSS_M1_GRACE_LEVELS[State.LockedLevel]
                        and State.BossM1GraceLevel ~= State.LockedLevel
                        and (hrp.Position - targetPos).Magnitude <= BOSS_M1_GRACE_ARRIVE then
                        State.BossM1GraceLevel = State.LockedLevel
                        State.BossM1GraceUntil = tick() + BOSS_M1_GRACE
                    end
                    local flyFocus = bossMode and target.CFrame.Position
                        or (orbitCenter or bringFocusPoint(target))

                    local flySpeed = castingSkill and (CONFIG.BossDodgeSpeed or 900)
                        or pyroActive and (CONFIG.PyroDodgeSpeed or 600)
                        or tweenSpeed()

                    do
                        local mapR = workspace:FindFirstChild("Map")
                        local dunR = mapR and mapR:FindFirstChild("Dungeon")
                        local lvR = State.LockedLevel
                        local flR = dunR and lvR and dunR:FindFirstChild(tostring(lvR))
                        if flR then
                            local bcR, bsR = nil, nil
                            pcall(function()
                                bcR = flR:GetAttribute("BoundingCF")
                                bsR = flR:GetAttribute("BoundingSize")
                            end)
                            if bcR and bsR and bsR.X > 0 and bsR.Z > 0 then
                                local mgR = CONFIG.RoomMargin or 40
                                local cxR, czR = bcR.Position.X, bcR.Position.Z
                                local hxR = math.max(bsR.X * 0.5 - mgR, 10)
                                local hzR = math.max(bsR.Z * 0.5 - mgR, 10)
                                targetPos = Vector3.new(
                                    math.clamp(targetPos.X, cxR - hxR, cxR + hxR),
                                    targetPos.Y,
                                    math.clamp(targetPos.Z, czR - hzR, czR + hzR)
                                )
                            end
                        end
                    end
                    flyTo(faceCFrame(targetPos, flyFocus), flySpeed, bossMode)
                    lastTargetPos   = targetPos
                    lastTargetFocus = flyFocus
                    local prefix = targetIsProp and T("清障 ", "Clear prop ") or T("飛往目標: ", "Flying to: ")
                    local tag = (not targetIsProp and target == gatheredTarget) and T(" [聚怪優先]", " [gathered]") or ""
                    local bringInfo = Config.BringMonsterEnabled and (State.BringInfo or "") or ""
                    State.StatusText = prefix .. (target.Parent and target.Parent.Name or "?") .. tag .. bringInfo
                end
            elseif BossZero:Transitioning() then
                State.FindingNextFloor = false
                clearPhaseStart = 0
                ensureFlyVelocity()
                if lastTargetPos then
                    pcall(function()
                        flyTo(faceCFrame(lastTargetPos, lastTargetFocus), tweenSpeed(), bossMode)
                    end)
                end
                State.StatusText = T("等待 Boss 下一段血條...", "Waiting for the next boss bar...")
            else

                if dungeonTeleporting and (tick() - lastDungeonTeleport) > 3 then
                    dungeonTeleporting = false
                end
                if clearPhaseStart == 0 then clearPhaseStart = tick() end

                if stuckSince == 0 then stuckSince = tick() end
                if not State.WideScan and (tick() - stuckSince) >= WIDE_SCAN_TRIGGER then
                    State.WideScan = true
                end
                local STUCK_BYPASS_TIME = 25
                if State.WideScan and (tick() - stuckSince) >= STUCK_BYPASS_TIME then
                    local function getFloorInfo()
                        local guid = pcall and (function()
                            local ok, v = pcall(function() return player:GetAttribute("ExplorerGUID") end)
                            return ok and v or nil
                        end)() or nil
                        if not guid then return nil, nil end
                        local dro = ReplicatedStorage:FindFirstChild("DungeonReplicationObjects")
                        if not dro then return nil, nil end
                        local info = dro:FindFirstChild(guid, true)
                        if not info then return nil, nil end

                        local highFloor = nil
                        pcall(function() highFloor = info:GetAttribute("CurrentExploredLevel") end)
                        local currentFloor = nil
                        pcall(function()
                            local ex = info:FindFirstChild("Explorers")
                            local me = ex and ex:FindFirstChild(guid)
                            if me then currentFloor = me:GetAttribute("FloorId") end
                        end)
                        return currentFloor, highFloor
                    end
                    local curFloor, highFloor = getFloorInfo()
                    local canBypass = (curFloor and highFloor and highFloor > curFloor) or
                                      (not curFloor)
                    if canBypass and not dungeonTeleporting then
                        State.StatusText = T("卡關偵測：強制走出口...", "Stuck bypass: forcing exit...")
                        local targetExit = ExitPortal.find(hrp, tonumber(State.LockedLevel), 5000)
                        if targetExit and tick() - lastDungeonTeleport >= 2 then
                            dungeonTeleporting = true
                            lastDungeonTeleport = tick()
                            ExitPortal.touch(targetExit, hrp)
                            safeDelay(1.2, function() dungeonTeleporting = false end)
                        end
                    end
                end
                do
                    local nowS = os.clock()
                    if nowS - (State.StuckChkAt or 0) >= 1 then
                        State.StuckChkAt = nowS
                        local sessS = nil
                        pcall(function()
                            local droS = ReplicatedStorage:FindFirstChild("DungeonReplicationObjects")
                            if droS then
                                for _, cS in ipairs(droS:GetChildren()) do
                                    if cS:FindFirstChild("Floors") then sessS = cS break end
                                end
                            end
                        end)
                        if sessS then
                            local totalS = sessS:GetAttribute("TotalEnemies")
                            local deadS = sessS:GetAttribute("DeadEnemies")
                            local enS = workspace:FindFirstChild("Enemies")
                            local aliveS = enS and #enS:GetChildren() or 0
                            if totalS and deadS and aliveS == 0 and deadS < totalS
                                and State.LockedLevel and (tick() - enterRoomTime) > 8 then
                                State.StuckSince = State.StuckSince or nowS
                                local spent = nowS - State.StuckSince
                                State.StatusText = T("卡關偵測：", "Stuck: ")
                                    .. tostring(deadS) .. "/" .. tostring(totalS)
                                    .. T(" 隻，等待 ", ", waiting ") .. string.format("%.0f", spent) .. "s"
                                if spent >= (tonumber(CONFIG.StuckRestartSec) or 12) then
                                    State.StuckSince = nil
                                    State.StatusText = T("卡關無法恢復，重新開始...", "Unrecoverable, restarting...")
                                    pcall(function() AutoHub.endRun() end)
                                    task.wait(2)
                                end
                            else
                                State.StuckSince = nil
                            end
                        end
                    end
                end
                local timeSinceEnter = tick() - enterRoomTime
                if timeSinceEnter < CONFIG.EnterRoomWaitTime then
                    local timeLeft = string.format("%.1f", CONFIG.EnterRoomWaitTime - timeSinceEnter)
                    State.StatusText = T("已進入第 ", "Entered floor ") .. tostring(State.LockedLevel) .. T(" 關，等待生怪 (", ", waiting for mobs (") .. timeLeft .. "s)..."
                    ensureFlyVelocity()
                else
                    if not dungeonTeleporting then

                        local targetExit = ExitPortal.find(
                            hrp,
                            tonumber(State.LockedLevel),
                            (State.LockedLevel == 15) and 2500 or 1200
                        )
                        if targetExit and tick() - lastDungeonTeleport >= 2 then
                            if Config.AutoReturnToHub and State.LockedLevel == (CONFIG.FinalDungeonLevel or 20) then
                                lastDungeonTeleport = tick()
                                AutoHub.endRun()
                                State.StatusText = T("最後一關打完，返回大廳...", "Final floor cleared, returning to hub...")
                            else
                                dungeonTeleporting = true
                                lastDungeonTeleport = tick()
                                local exitLevel = State.LockedLevel

                                ensureFlyVelocity()
                                ExitPortal.touch(targetExit, hrp)
                                State.StatusText = T("遠端開門 → 下一關...", "Opening exit remotely...")
                                task.spawn((function()
                                    local deadline = os.clock() + 15
                                    while scriptRunning and dungeonTeleporting
                                        and State.LockedLevel == exitLevel and os.clock() < deadline do
                                        if not targetExit.Parent then break end

                                        ExitPortal.touch(targetExit, hrp)
                                        task.wait(0.6)
                                    end
                                    if State.LockedLevel == exitLevel then
                                        dungeonTeleporting = false
                                    end
                                end))
                            end
                        else

                            ensureFlyVelocity()
                            if autoStartFlying then
                                State.StatusText = T("飛往開始點...", "Flying to start pad...")
                            else
                                State.StatusText = State.LockedLevel == 15 and T("第15關Boss打完，擴大搜尋出口中...", "Floor 15 boss cleared, expanding exit search...") or T("尋找出口中...", "Searching for exit...")
                            end
                        end
                    end
                end
            end
        else
            State.FindingNextFloor = false
            State.WideScan = false

            State.FloorCleared = false
            clearPhaseStart = 0
            wideScanTarget = nil
            if followingPlayerNow then
                State.StatusText = T("跟隨玩家中...", "Following selected player...")
            elseif autoStartFlying then
                State.StatusText = T("飛往開始點...", "Flying to start pad...")
            else
                pcall(function()
                    local flyBv = hrp:FindFirstChild("FlyVelocity")
                    if flyBv then flyBv:Destroy() end
                end)
                stopFly()
                State.StatusText = State.AutoFarm and T("攻擊待命", "Attack Ready") or T("待機中", "Idle")
            end
        end
        do

            local m0 = workspace:FindFirstChild("Map")
            local inDungeonNow = (m0 and m0:FindFirstChild("Dungeon")) ~= nil
            statusLabel:SetTitle(
                followingPlayerNow
                    and (T("跟隨玩家 | 狀態：", "Following | Status: ") .. tostring(State.StatusText))
                    or ((not inDungeonNow)
                        and (T("大廳 | 狀態：", "Hub | Status: ") .. tostring(State.StatusText)))
                    or (T("關卡：第 ", "Floor: ") .. tostring(State.LockedLevel) .. T(" 關 | 狀態：", " | Status: ") .. tostring(State.StatusText))
            )
        end
    end
end)
if _G.AutoCard_Enabled then startCardAuto() end
if Config.AutoBuyTrinkets or Config.AutoFuseCleanTrinkets then
    TrinketAutomation.StartWorker()
end
task.spawn((function()
    local lastChar = nil
    while scriptRunning do
        task.wait(0.25)
        local want = (CONFIG.NoClip ~= false) and (State.AutoFarm or Config.AutoStartDungeon)
        if want then
            if not steppedCanCollideConn then startSteppedCanCollide() end
            local ch = player.Character
            if ch and ch ~= lastChar then
                lastChar = ch
                steppedCharCache = nil
                steppedCacheTime = 0
            end
        elseif steppedCanCollideConn then
            stopSteppedCanCollide()
        end
    end
end))
task.spawn(mainLoop)
